# Supabase project settings (Project Settings → API Keys). See docs/SETUP.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of the app, used in auth email and invitation links.
# Optional locally; set to the production URL in Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Never expose a Supabase secret/service-role key in this app.
